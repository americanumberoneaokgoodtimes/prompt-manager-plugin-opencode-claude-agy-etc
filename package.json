{
  "name": "@americanumberoneaokgoodtimes/p-plugin",
  "version": "1.0.1",
  "description": "Multi-tool Prompt Manager plugin for Antigravity, Claude Code, and OpenCode (/p <id>, /p e <id> <text>, /p d <id>).",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "p": "./scripts/p.mjs"
  },
  "main": "./opencode/plugin.js",
  "types": "./opencode/plugin.d.ts",
  "files": [
    "opencode",
    "scripts",
    "skills",
    "assets",
    "hooks",
    "hooks.json",
    "mcp_config.json",
    ".mcp.json",
    ".antigravity-plugin",
    ".claude-plugin",
    "plugin.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./opencode/plugin.d.ts",
      "default": "./opencode/plugin.js"
    },
    "./opencode": {
      "types": "./opencode/plugin.d.ts",
      "default": "./opencode/plugin.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/americanumberoneaokgoodtimes/prompt-manager-plugin-opencode-claude-agy-etc"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test scripts/prompt-manager.test.mjs"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "antigravity",
    "claude-code",
    "plugin",
    "prompts",
    "prompt-manager",
    "mcp"
  ]
}
