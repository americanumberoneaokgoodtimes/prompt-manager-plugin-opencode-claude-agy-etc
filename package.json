{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@americanumberoneaokgoodtimes/p-plugin",
  "version": "1.0.3",
  "description": "Simple prompt saver, agent harness CLI instruction template manager, plugin for Antigravity, Claude Code, and OpenCode (Usage: /p <name> sends your saved instruction, /p e <name> {instruction_text} saves your prompt, /p d <name> deletes it. Example: /p e fix \"fix any buggy\" [ENTER->] /p fix [ENTER->] Reticulating Tokenizer...Got them buggies!).",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "p": "./scripts/p.mjs"
  },
  "main": "./opencode/plugin.js",
  "types": "./opencode/plugin.d.ts",
  "files": [
    "opencode",
    "scripts",
    "skills",
    "assets",
    "hooks",
    "hooks.json",
    "mcp_config.json",
    ".mcp.json",
    ".antigravity-plugin",
    ".claude-plugin",
    "plugin.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./opencode/plugin.d.ts",
      "import": "./opencode/plugin.js",
      "default": "./opencode/plugin.js"
    },
    "./opencode": {
      "types": "./opencode/plugin.d.ts",
      "import": "./opencode/plugin.js",
      "default": "./opencode/plugin.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/americanumberoneaokgoodtimes/prompt-manager-plugin-opencode-claude-agy-etc"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test scripts/prompt-manager.test.mjs"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "^2.4.1"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "antigravity",
    "claude-code",
    "plugin",
    "prompts",
    "prompt-manager",
    "mcp"
  ]
}
